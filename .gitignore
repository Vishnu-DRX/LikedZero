# Claude Code local overrides
.claude/settings.local.json

# Local enrichment cache (contains your library's artist ids); Phase 4 workflow will commit it with git add -f
.cache/enrichment.json
config.local.yaml

# Local dry-run/real run logs (dated); the Phase 4 workflow commits them with git add -f
logs/2*.json
config.draft.yaml

# Run artifacts contain song titles; the Actions workflow force-adds them (Phase 4)
logs/latest-plan.json
logs/runs.json
logs/backtest-detail.*
logs/screens/
logs/local/

# artist_in_playlist measurement detail (contains real playlist names); the committed report is counts-only
logs/measure-artist_in_playlist-detail.md
logs/measure-round-2-detail.md

# atomic-write temp files
logs/.tmp-*
.cache/.enrichment-*.tmp

# Real --restore journal (P1-4, decision 44): never committed, even though logs/2*.json now IS (with the
# uri redacted). The Actions workflow uploads this as its own artifact instead.
logs/restore-journal.json
